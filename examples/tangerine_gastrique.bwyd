
TITLE: "Tangerine Gastrique"
TEXT: "A sweet and sour sauce from fresh fruit"
AUTHOR: "Paco Nathan https://derwen.ai/paco"
LICENSE: "CC-BY-NC-SA-4.0"
UPDATED: "2026-03-21"
CITE: "https://www.emerils.com/121857/seared-scallops-arugula-and-tangerines-tangerine-gastrique"
CITE: "https://www.foodnetwork.com/recipes/bobby-flay/roasted-turkey-a-la-tangerine-3381130"

CLOSURE: "Tangerine Gastrique" AS sauce
    TEXT: "Makes a light tangy sauce, blends well with others"
    KEYWORDS: French, sweet_sour

    CONTAINER pan: "small sauté pan"
    TOOL spatula: "silicone spatula"

    INGREDIENT sugar: "granulated sugar"
    INGREDIENT vinegar: "raw cider vinegar, rice wine vinegar, or others"
    INGREDIENT juice: "fresh tangerine juice, or other acidic fruit"
    INGREDIENT salt: "sea salt"

    ACTIVITY pan: "bring to a boil"

    ADD sugar (200 g)
    // 1 cup
    NOTE: "substitute honey (150 g) for a bolder flavor"
    ADD vinegar (120 ml)
    // 1/2 cup
    ADD juice (120 ml)
    // 1/2 cup

    ACTION spatula: "blend"
        UNTIL: "evenly mixed"
        TIME (1 minute)

    HEAT pan: "stir over high heat"
        UNTIL: "bring to a boil"
        TIME (3 minute)

    HEAT pan: "reduce to a simmer"
        UNTIL: "reduce to half; liquid should be the consistency of maple syrup"
        TIME (10 minute)


    ACTIVITY pan: "let cool"

    WAIT
        UNTIL: "sauce cools enough to taste"
	TIME (5 minute)

    ADD salt (1.4 g): "add salt to taste"
    // dash sea salt

YIELDS tangerine_gastrique (4)
;
