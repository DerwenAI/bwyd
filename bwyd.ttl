@prefix bwyd:     <https://github.com/DerwenAI/bwyd/wiki/ns#> .

@prefix bbo:      <https://www.irit.fr/recherches/MELODI/ontologies/BBO#> .
@prefix dc:       <http://purl.org/dc/elements/1.1/> .
@prefix dcmit:    <http://purl.org/dc/dcmitype/> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix foodon:   <http://purl.obolibrary.org/obo/FOODON_> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix ppcl:     <http://www.semantic-web.at/ppcl/> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix void:     <http://rdfs.org/ns/void#> .
@prefix wd:       <http://www.wikidata.org/entity/> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .


<https://contextually.poolparty.biz/bwyd> a void:Dataset ;
  ppcl:numberOfConcepts "3"^^xsd:int ;
  ppcl:numberOfConceptSchemes "1"^^xsd:int ;
  ppcl:availablelanguages "fr", "es", "en" ;
  dcterms:creator <https://contextually.poolparty.biz/user/3d5c61e1-814a-43f8-8695-6afd519c37eb> ;
  dcterms:language "en" ;
  dcterms:date "2026-03-10T18:14:00.000Z"^^xsd:dateTime ;
  dcterms:title "bwyd"@en ;
  void:sparqlEndpoint <https://contextually.poolparty.biz/PoolParty/sparql/bwyd> ;
  void:feature _:node2 ;
  void:vocabulary <http://www.w3.org/2004/02/skos/core#> ;
.

_:node2 a void:TechnicalFeature ;
  rdfs:label "RDF/XML" ;
  dcterms:format "application/rdf+xml" ;
.


bwyd:BwydScheme a skos:ConceptScheme ;
  dcterms:title "Resource"@en ;
  skos:definition "A mid-level SKOS taxonomy used for representing culinary recipes in the Bwyd DSL"@en ;
  skos:hasTopConcept bwyd:Recipe ;
  skos:prefLabel "Bwyd minimal SKOS taxonomy"@en ;
  dcterms:publisher <https://derwen.ai/> ;
  dcterms:creator <https://orcid.org/0000-0003-3167-1539> ;
.

bwyd:Keyword a skos:Concept ;
  dc:identifier wd:Q1072684 ;
  skos:definition "Keyword is a phrase with a special meaning in a domain context, used for recall"@en ;
  skos:inScheme bwyd:BwydScheme ;
  skos:topConceptOf bwyd:BwydScheme ;
  skos:prefLabel "Keyword"@en, "Mot Clé"@fr ;
.

bwyd:Recipe a skos:Concept, bbo:DataObject ;
  dc:identifier wd:Q219239 ;
  skos:definition "Recipe is a set of instructions for preparing a processed food item"@en ;
  skos:inScheme bwyd:BwydScheme ;
  skos:topConceptOf bwyd:BwydScheme ;
  skos:prefLabel "Recipe"@en, "Recette"@fr ;
  skos:altLabel "Module"@en ;
.

bwyd:Closure a skos:Concept ;
  dc:identifier wd:Q320346 , wd:Q1751609 ;
  skos:definition "Closure is a component of other recipes, which may be reused in multiple ways"@en ;
  skos:inScheme bwyd:BwydScheme ;
  skos:topConceptOf bwyd:BwydScheme ;
  skos:prefLabel "Closure"@en, "Clôture"@fr ;
.


bwyd:relation a rdf:Property .

bwyd:depends_on rdfs:subPropertyOf bwyd:relation ;
  rdfs:domain bwyd:Recipe ;
  rdfs:range bwyd:Closure ;
  skos:definition "indicates which closures are dependent for the recipe"@en ;
.


bwyd:Recipe_Shape a sh:NodeShape ;
  sh:targetClass bwyd:Recipe ;
  sh:property [
    sh:path dcterms:title ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    ] ; 
  sh:property [
    sh:path skos:definition ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    ] ; 
  sh:property [
    sh:path dcterms:license ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    ] ;
  sh:property [
    sh:path dcterms:creator ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    ] ;
  sh:property [
    sh:path dcterms:modified ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    ] ;
  sh:property [
    sh:path dcmit:Image ;
    sh:nodeKind sh:IRI ;
    sh:minCount 0 ;
    ] ;
  sh:property [
    sh:path dc:source ;
    sh:nodeKind sh:IRI ;
    sh:minCount 0 ;
    ] ;
  sh:property [
    sh:path bwyd:depends_on ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    ] ;
.


----------------------------------------------------------------------

<urn:bwyd:panna_cotta> a bwyd:Recipe ;
  dcterms:title "Panna Cotta"@en ;
  skos:definition "A light, creamy dessert which pairs with so many fruits"@en ;
  dcterms:license <https://spdx.org/licenses/CC-BY-NC-SA-4.0> ;
  dcterms:creator <https://derwen.ai/paco> ;
  dcterms:modified "2022-07-16"^^xsd:dateTime ;
  dcmit:Image <https://www.instagram.com/p/CgGYEZFL7Dx/> ;
  dc:source <https://www.thekitchn.com/how-to-make-panna-cotta-cooking-lessons-from-the-kitchn-200070> ,
    <https://mytastefulrecipes.com/almond-milk-panna-cotta-recipe/> ;
  bwyd:depends_on (
    <urn:bwyd:panna_cotta/closure_1>
    <urn:bwyd:panna_cotta/closure_2>
  )
.


<urn:bwyd:panna_cotta/closure_1> a bwyd:Closure ;
  dcterms:title "mix the cream"@en ;
  skos:definition "Prepare the cream filling"@en ;
.


<urn:bwyd:panna_cotta/closure_2> a bwyd:Closure ;
  dcterms:title "chill in containers"@en ;
  skos:definition "Fill the ramekins and chill"@en ;
.


