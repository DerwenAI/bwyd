<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link
      rel="icon"
      href="/static/bwyd.ico"
      sizes="32x32"
      >
    <link
      rel="icon"
      href="/static/bwyd.svg"
      type="image/svg+xml"
      >

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
      >
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
      >
    <style>
/* fonts, icons */
@import url("https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&display=swap");

/* structural */
html, h1, h2, h3, h4, h5, p, span, cite, figcaption, button, input, select, textarea {
    font-family: "Atkinson Hyperlegible", sans-serif;
}

body {
    color: hsl(0, 0%, 40%);
}

h2 {
    font-weight: bold;
    margin-bottom: 1em;
}

p {
    font-weight: normal;
    font-size: 1.1em;
    line-height: 1.3em;
    margin: 1.2em 0 .5em 0;
}

button,
[type="button"],
[type="reset"],
[type="submit"],
[type="image"],
[type="checkbox"],
[type="radio"],
summary {
    cursor: pointer;
}

button.nav-link:hover {
    color: white !important;
    background-color: hsl(289, 17%, 49%) !important;
}

.nav-link {
    color: hsl(306, 45%, 57%);
}

.accordion-button:not(.collapsed) {
    background-color: hsl(65, 46%, 58%);
}

.accordion-button.collapsed {
    background-color: hsl(308, 16%, 82%);
}

.text-bg-primary {
    color: hsl(289, 17%, 49%) !important;
    background-color: hsl(65, 46%, 58%) !important;
}

.alert-secondary {
    color: white;
    background-color: hsl(55, 17%, 49%);
    font-weight: bold;
}

a {
    color: hsl(55, 17%, 49%);
    background-color: white;
    font-weight: bold;
}

a:visited {
    color: hsl(55, 17%, 49%);
    background-color: white;
}

a:hover {
    color: white;
    background-color: hsl(55, 17%, 49%);
}

a {
    text-decoration: none !important;
}

details summary {
    list-style-type:none;
    font-size: 1.3em;
    margin-left:.5em;
    color:hsl(306, 45%, 57%);
}

.bywd_title {
    font-weight: bold;
    margin:.5em 0 .5em 0;
}

div.card {
    width: 93%;
}

p.card-text {
    margin-top: 0;
}

div.nav_tabs {
    width: 93%;
}

table.details {
    max-width: 23rem;
}

li.details {
    padding-top: 0;
    padding-left: 0;
}

div.ingred {
    max-height: 23rem;
}

span.closure_title {
    font-weight: bold;
    font-size: 1.4em;
}

div.closure_meta {
    margin-bottom: 1rem;
    max-width: 93%;
}

span.closure_meta {
    padding-top: 0;
    padding-left: 2em;
}

p.closure_meta {
    margin-top: 0;
}

p.focus {
    margin-top: 0;
    margin-left: .3em;
}

p.focus span {
    font-size: 1.1em;
}

div.activity {
    width: 93%;
}

div.activity_title {
    margin-bottom: 0;
}

div.activity_text {
    margin: .3em 0 0 0;
    padding: 0 0 0 0;
}

div.activity_step {
    margin: .5em 0 0 1em;
}

div.activity_yields {
    margin: 1em 0 0 1em;
}

div.activity_store {
    margin: .2em 0 0 1.5em;
}

.text-bg-yields {
    color: hsl(65, 46%, 58%) !important;
    background-color: hsl(289, 17%, 49%) !important;
}

div.activity_note {
    margin-bottom: 0;
    padding: 1em;
    background-color: hsl(308, 16%, 82%);
}

div.activity_note p {
    margin: 0;
}

span.action_span {
    font-size: 1.1em;
}

div#footer {
    margin: .5em 1em 0 0;
    font-size: smaller;
}

div#footer-thumb {
    float: left;
}

div#footer-thumb img {
    height: 3em;
    padding: .1em;
    float: left;
}

div#footer-content {
    float: left;
}

div#footer-content p {
    float: left;
    margin: 0;
    padding: 0 0 1em .5em;
}
    </style>
    <title>{{ recipe.title }}</title>
  </head>
  <body>
    <div id="main" class="container-fluid">
      <main>
	<div class="container">
	  <h1 class="bwyd_title">
	    {% if edit -%}
	    <span style="font-size: .5em;">
	      <a
		href="/edit/{{ slug }}"
		title="edit this Bywd source file"
		><i class="bi bi-pencil-square"></i>
		&nbsp;
	      </a>
	    </span>
	    {% endif %}
	    {{ recipe.title }}
	  </h1>
	  <div class="row">
	    <div class="col">
	      <!-- recipe description -->
	      <div class="card"
		   >
		<div class="card-body">
		  <p class="card-text">{{ recipe.text }}</p>
		  &nbsp;
		  <a
		    href="/dl/{{ slug }}"
		    target="export_iframe"
		    title="download the Bywd source file"
		    ><i class="bi bi-download"></i></a>
		</div>
	      </div>
	    </div>
	    <div class="col-6">
	      <!-- recipe metadata -->
	      <nav>
		<div class="nav nav-tabs" id="nav-tab" role="tablist"
		     >
		  <button class="nav-link active" id="nav-details-tab" data-bs-toggle="tab" data-bs-target="#nav-details" type="button" role="tab" aria-controls="nav-details" aria-selected="true"><strong>Details</strong></button>
		  <button class="nav-link" id="nav-ingred-tab" data-bs-toggle="tab" data-bs-target="#nav-ingred" type="button" role="tab" aria-controls="nav-ingred" aria-selected="false"><strong>Ingredients</strong></button>
		  <button class="nav-link" id="nav-sources-tab" data-bs-toggle="tab" data-bs-target="#nav-sources" type="button" role="tab" aria-controls="nav-sources" aria-selected="false"><strong>Sources</strong></button>
		  <button class="nav-link" id="nav-gallery-tab" data-bs-toggle="tab" data-bs-target="#nav-gallery" type="button" role="tab" aria-controls="nav-gallery" aria-selected="false"><strong>Gallery</strong></button>
		</div>
	      </nav>
	      <div class="tab-content" id="nav-tabContent">
		<!-- details -->
		<div class="tab-pane fade show active" id="nav-details" role="tabpanel" aria-labelledby="nav-details-tab" tabindex="0">
		  <table class="table details">
		    <tbody>
		      <tr>
			<th scope="row">serves:</th>
			<td>
			  <ul class="list-group list-group-flush">
			  {% for product in recipe.details.serves %}
			  <li class="list-group-item details">
			    {{ product }}
			  </li>
			  {% endfor %}
			  </ul>
			</td>
		      </tr>

		      <tr>
			<th scope="row">duration:</th>
			<td>{{ recipe.details.duration }}</td>
		      </tr>

		      {% if recipe.details.keywords|length > 0 -%}
		      <tr>
			<th scope="row">keywords:</th>
			<td>
			  {% for keyword in recipe.details.keywords %}
  			  {{ keyword.symbol }}{{ ", " if not loop.last else "" }}
			  {% endfor %}
			</td>
		      </tr>
		      {% endif %}

		      <tr>
			<th scope="row">author:</th>
			<td>{{ recipe.details.author|safe }}</td>
		      </tr>

		      <tr>
			<th scope="row">updated:</th>
			<td>{{ recipe.details.updated }}</td>
		      </tr>
		    </tbody>
		  </table>
		</div>

		<!-- ingred -->
		<div class="tab-pane fade overflow-scroll ingred" id="nav-ingred" role="tabpanel" aria-labelledby="nav-ingred-tab" tabindex="0">
		  <table class="table">
		    <tbody>
		      {% for ingr in recipe.ingredients %}
		      <tr>
			<td>
			  {{ ingr.amount }}

			  {% if ingr.convert -%}
			  ({{ ingr.convert }})
			  {% endif %}
			</td>
			<td>
			  <strong>{{ ingr.symbol | replace("_", " ") }}</strong>
			  <br>
			  {{ ingr.text }}
			</td>
		      </tr>
		      {% endfor %}
		    </tbody>
		  </table>
		</div>

		<!-- sources -->
		<div class="tab-pane fade" id="nav-sources" role="tabpanel" aria-labelledby="nav-sources-tab" tabindex="0">
		  <ul class="list-group list-group-flush">
		    {% for cite_url in recipe.sources %}
		    <li class="list-group-item">
		      <a
			href="{{ cite_url }}"
			target="_blank"
			>
			{{ cite_url }}
		      </a>
		    </li>
		    {% endfor %}
		  </ul>
		</div>

		<!-- gallery -->
		<div class="tab-pane fade" id="nav-gallery" role="tabpanel" aria-labelledby="nav-gallery-tab" tabindex="0">
		  <ul class="list-group list-group-flush">
		    {% for post_url in recipe.gallery %}
		    <li class="list-group-item">
		      <a
			href="{{ post_url }}"
			target="_blank"
			>
			{{ post_url }}
		      </a>
		    </li>
		    {% endfor %}
		  </ul>
		</div>
	      </div>
	    </div>

	    <div class="col ratio ratio-1x1">
	      <!-- thumbnail -->
	      {% if recipe.image|length %}
	      <iframe
		src="{{ recipe.image }}"
		></iframe>
	      {% else %}
	      <img
		src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAAXNSR0IArs4c6QAAAA1JREFUGFdjOHv2zH8ACDcDZodV/EEAAAAASUVORK5CYII="
		>
	      {% endif %}
	    </div>
	  </div>

	  <!-- recipe directions -->
	  <h4 class="bg-tertiary-subtle">directions:</h4>
	  <div class="accordion" id="accordionExample">
	    {% for closure in recipe.closures %}
	    <div class="accordion-item">
	      <h3 class="accordion-header">
		<button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse{{ loop.index }}" aria-expanded="true" aria-controls="collapse{{ loop.index }}">
		  <span class="closure_title">{{ closure.title }}</span>
		</button>
	      </h3>

	      <div id="collapse{{ loop.index }}" class="accordion-collapse collapse show" data-bs-parent="#accordionExample">
		<div class="accordion-body">
		  <div class="row">

		    <!-- closure metadata -->
		    <div class="col">
		      <div class="card closure_meta">
			<div class="card-body">
			  <p class="card-text closure_meta">{{ closure.text }}</p>

			  <p>
			  {% if closure.supers is defined and closure.supers|length > 0 -%}
			    <em>supers:</em>
			    {% for super in closure.supers %}
  			    {{ super.symbol }}{{ ", " if not loop.last else "" }}
			    {% endfor %}
			    <br/>
			  {% endif %}

			  {% if closure.keywords is defined and closure.keywords|length > 0 -%}
			    <em>keywords:</em>
			    {% for keyword in closure.keywords %}
  			    {{ keyword.symbol }}{{ ", " if not loop.last else "" }}
			    {% endfor %}
			  {% endif %}
			  </p>

			  <p>
			    yields:
			    {% for product in closure.yields %}
			    <br>
			    <span class="closure_meta">
			      <strong>{{ product | replace("_", " ") }}</strong>
			    </span>
			    {% endfor %}
			  </p>
			</div>
		      </div>
		    </div>

		    <!-- closure requires -->
		    <div class="col">
		      <dl>
			{% for req in closure.containers %}
			<dt>
			  <strong>{{ req.name }}</strong>
			</dt>
			<dd>
			  <em>{{ req.text }}</em>

			  {% if req.note -%}
			  <details>
			    <summary><i class="bi bi-journal-text"></i></summary>
			    <div class="alert alert-tertiary activity_note" role="alert">
			      <p>{{ req.note.text }}</p>
			    </div>
			  </details>
			  {% endif %}
			</dd>
			{% endfor %}

			{% for req in closure.tools %}
			<dt>
			  <strong>{{ req.name }}</strong>
			</dt>
			<dd>
			  <em>{{ req.text }}</em>

			  {% if req.note -%}
			  <details>
			    <summary><i class="bi bi-journal-text"></i></summary>
			    <div class="alert alert-tertiary activity_note" role="alert">
			      <p>{{ req.note.text }}</p>
			    </div>
			  </details>
			  {% endif %}
			</dd>
			{% endfor %}

			{% for req in closure.prep %}
			<dt>
			  <strong>{{ req.name | replace("_", " ") }}</strong>
			</dt>
			<dd>
			  <em>{{ req.text }}</em>

			  {% if req.note -%}
			  <details>
			    <summary><i class="bi bi-journal-text"></i></summary>
			    <div class="alert alert-tertiary activity_note" role="alert">
			      <p>{{ req.note.text }}</p>
			    </div>
			  </details>
			  {% endif %}
			</dd>
			{% endfor %}

			{% for req in closure.ingredients %}
			<dt>
			  <strong>{{ req.name | replace("_", " ") }}</strong>
			</dt>
			<dd>
			  <em>{{ req.text }}</em>

			  {% if req.note -%}
			  <details>
			    <summary><i class="bi bi-journal-text"></i></summary>
			    <div class="alert alert-tertiary activity_note" role="alert">
			      <p>{{ req.note.text }}</p>
			    </div>
			  </details>
			  {% endif %}
			</dd>

			{% endfor %}
		      </dl>
		    </div>

		    <!-- activity -->
		    {% for act in closure.activities %}
		    <div class="row">
		      <div class="col">
			<div class="card activity">
			  <div class="alert alert-secondary activity_title" role="alert">
			    {{ act.title }}
			  </div>

			  <div class="card-text activity_text">
			    <p class="focus">
			      in
			      <span class="badge text-bg-primary">{{ act.container }}</span><strong>&nbsp;&rarr;</strong>
			    </p>

			    <ul class="list-group list-group-flush">
			    <!-- add / transfer -->
			    {% for item in act.uses %}
			      <li class="list-group-item">
				<div class="activity_step">
				{% if item.kind == "transfer" -%}
				  transfer from <strong>{{ item.subject | replace("_", " ") }}</strong>
				{% else %}
				  {% if item.external %}
				  use
				  {% else %}
  				  add
				  {% endif %}
				  <strong>{{ item.subject | replace("_", " ") }}</strong>:
  				  {{ item.amount }}

				  {% if item.convert -%}
 				    ({{ item.convert }})
				  {% endif %}

				  {% if item.text|length -%}
				  <br>
				  <em>{{ item.text }}</em>
				  {% endif %}
				{% endif %}
				</div>

				{% if item.note -%}
				<details>
				  <summary><i class="bi bi-journal-text"></i></summary>
				  <div class="alert alert-tertiary activity_note" role="alert">
				    <p>{{ item.note.text }}</p>
				  </div>
				</details>
				{% endif %}
			      </li>
			    {% endfor %}
			    </ul>
			    <hr>

			    <!-- action / ops -->
			    <ul class="list-group list-group-flush">
			    {% for item in act.ops %}
			      <li class="list-group-item">
				<div class="activity_step">
				  {% if item.kind == "action" -%}
				  with
				  <span class="badge text-bg-primary action_span">
				    {{ item.subject }}
				  </span>
				  <br>
				  <strong>{{ item.text }}</strong>
				  <br>
				  until <em>{{ item.until }}</em>
				  <br>
				  ({{ item.time }})

				  {% elif item.kind == "wait" -%}
				  <strong>{{ item.kind }}</strong>
				    {% if item.text|length -%}
				    - {{ item.text }}
  				    {% endif %}
				  <br>
				  until <em>{{ item.until }}</em>
				  <br>
				  ({{ item.time }})

				  {% elif item.kind == "heat" -%}
				  <strong>{{ item.kind }}</strong> {{ item.subject }}
				    {% if item.text|length -%}
				    <br>
				    <strong>{{ item.text }}</strong>
  				    {% endif %}
				  <br>
				  until <em>{{ item.until }}</em>
				  <br>
				  ({{ item.time }})

				  {% elif item.kind == "chill" -%}
				  <strong>{{ item.kind }}</strong> {{ item.subject }}
				    {% if item.text|length -%}
				    - {{ item.text }}
  				    {% endif %}
				  <br>
				  until <em>{{ item.until }}</em>
				  <br>
				  ({{ item.time }})

				  {% elif item.kind == "bake" -%}
				  <strong>{{ item.mode }}</strong> {{ item.subject }} at <strong>{{ item.temperature }}</strong>
				    {% if item.text|length -%}
				    - {{ item.text }}
  				    {% endif %}
				  <br>
				  until <em>{{ item.until }}</em>
				  <br>
				  ({{ item.time }})

				  {% endif %}
				</div>

				{% if item.note -%}
				<details>
				  <summary><i class="bi bi-journal-text"></i></summary>
				  <div class="alert alert-tertiary activity_note" role="alert">
				    <p>{{ item.note.text }}</p>
				  </div>
				</details>
				{% endif %}

				<!-- yields / store -->
				{% if item.yields -%}
				<div class="activity_yields">
				  <strong>&nbsp;&larr;</strong>
				  yields
				  <span class="badge text-bg-yields action_span">
				    {{ item.yields.amount }}
				    {{ item.yields.name | replace("_", " ") }}
				  </span>

				  {% if item.yields.store -%}
				  <div class="activity_store">
				    store <strong>{{ item.yields.store.text }}</strong>
				    <br>
				    upto <em>{{ item.yields.store.upto }}</em>
				  </div>
				  {% endif %}
				</div>
				{% endif %}
			      </li>
			    {% endfor %}
			    </ul>
			    <hr>

			  </div>
			  <div class="col">
			    &nbsp;
			  </div>
			</div>
		      </div>
		    </div>
		    {% endfor %}

		    <!-- ratio -->
		    {% if closure.ratio|length > 0 -%}
		    <h5 class="bg-tertiary-subtle" style="margin-top: 1em;">ratios:</h5>
		    {% for ratio in closure.ratio %}
		    <div class="activity_step">
		      <strong>{{ ratio.name }}</strong> &nbsp;&#61;&nbsp;	      
		      <em>{{ ratio.formula }}</em>
		      <div class="activity_store">
		      {% for key, val in ratio.parts.items() %}
		        <strong>{{ key }}</strong>: {{ val }}
 		        <br>
		      {% endfor %}
		      </div>
		    </div>
		    {% endfor %}
		    {% endif %}

		  </div> <!-- closure accordian body row -->
		</div>
	      </div>
	    </div>

	    {% endfor %}
	  </div>

	  <!-- license -->
	  {% set lic = recipe.license %}
	  <footer>
	    <div id="footer">
	      <div id="footer-thumb">
		<img
		  src="{{ recipe.icon }}"
		  alt="Bwyd logo"
		  >
	      </div>
	      <div id="footer-content">
		<p>
		  {% if lic is not none -%}
  		  license:
		  <strong>
		    <a
		      href="https://spdx.org/licenses/{{ lic.id }}.html"
		      target="_blank"
		      rel="license"
		      >{{ lic.name }}</a>
		  </strong>
		  <br>
		  {% endif %}
		  powered by
		  <a
		    href="https://github.com/DerwenAI/bwyd"
		    target="_blank"
		    >Bwyd</a>
		</p>
	      </div>
            </div>
	  </footer>
	</div>
      </main>
    </div>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
      ></script>
    <script
      src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
      integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
      crossorigin="anonymous"
      ></script>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
      integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
      crossorigin="anonymous"
      ></script>

    <script type="application/ld+json">
      {{ recipe.schema_org }}
    </script>
  </body>
</html>
