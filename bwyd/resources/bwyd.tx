Recipe:
  "RECIPE:" title=STRING
  "TEXT:" text=STRING
  meta+=Recipe_Metadata
  closures+=Closure
;

Recipe_Metadata:
  Author | Updated | License | Post | Cite
;

Author:
  "AUTHOR:" name=STRING
;

Updated:
  "UPDATED:" date=STRING
;

License:
  "LICENSE:" spdx_id=STRING
;

Cite:
  "CITE:" url=STRING
;

Post:
  "POST:" url=STRING
;

Closure:
  "CLOSURE:" name=STRING
    ("TEXT:" text=STRING)?
    ("SUPER:" super=ID)?
    ("KEYWORD:" keyword=ID)?
    depend+=Dependency
    activities+=Activity
    ratio=Ratio?
  ";"
;

Dependency:
  Container | Tool | Ingredient | Use
;

Container:
  "CONTAINER" symbol=ID ":" text=STRING
  (note=Note)?
;

Tool:
  "TOOL" symbol=ID ":" text=STRING
  (note=Note)?
;

Ingredient:
  "INGREDIENT" symbol=ID ":" text=STRING
  (note=Note)?
;

Use:
  "USE" symbol=ID ":" text=STRING
  (note=Note)?
;

Activity:
  "ACTIVITY" symbol=ID ":" text=STRING
   input+=Input
   ops+=Op
;

Input:
  Add | Transfer
;

Add:
  "ADD" symbol=ID measure=Measure (":" text=STRING)?
  (note=Note)?
;

Transfer:
  "TRANSFER" symbol=ID
  (note=Note)?
;

Op:
  Transform | Heat | Chill | Bake
;

Transform:
  Action | Wait
;

Action:
  "ACTION" symbol=ID (":" modifier=STRING)?
    "UNTIL:" until=STRING
    "TIME" duration=Duration
    (yields=Yields)?
    (note=Note)?
;

Wait:
  "WAIT" (":" modifier=STRING)?
    "UNTIL:" until=STRING
    "TIME" duration=Duration
    (yields=Yields)?
    (note=Note)?
;

Heat:
  "HEAT" symbol=ID (":" modifier=STRING)?
    "UNTIL:" until=STRING
    "TIME" duration=Duration
    (yields=Yields)?
    (note=Note)?
;

Chill:
  "CHILL" symbol=ID (":" modifier=STRING)?
    "UNTIL:" until=STRING
    "TIME" duration=Duration
    (yields=Yields)?
    (note=Note)?
;

Bake:
  OvenMode symbol=ID (":" modifier=STRING)?
    "AT:" temperature=Temperature
    "UNTIL:" until=STRING
    "TIME" duration=Duration
    (yields=Yields)?
    (note=Note)?
;

OvenMode:
  "BAKE" | "ROAST" | "BROIL" | "TOAST" | "PRESSURE"
;

Measure:
  "(" amount=NUMBER (units=MeasureUnits)? ")"
;

MeasureUnits:
  "g" | "kg" | "ml" | "l"
;

Duration:
  "(" amount=NUMBER units=DurationUnits ")"
;

DurationUnits:
  "second" | "minute" | "hour" | "day" | "month" | "year"
;

Temperature:
  amount=NUMBER units=TemperatureUnits
;

TemperatureUnits:
  "C"
;

Yields:
  "YIELDS" symbol=ID measure=Measure (intermediate="INTERMEDIATE")?
  (store=Store)?
;

Store:
  "STORE" (":" modifier=STRING)?
     "UPTO" duration=Duration
;

Note:
  "NOTE:" text=STRING
;

Ratio:
  "RATIO:" name=STRING "=" (parts+=RatioPart[','])
  (note=Note)?
;

RatioPart:
    symbol=ID ('[' components+=ID[','] ']')?
;

Comment:
  /\/\/.*$/
;
